# Copy to /home/CPANEL_USER/apps/PROJECT/shared/.env.local on hosting ONLY.
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
DEFAULT_URI=https://demo.example.com
# URL-encode username/password. Confirm hostname/version with cPanel.
DATABASE_URL="mysql://CPANEL_DBUSER:URL_ENCODED_PASSWORD@localhost:3306/CPANEL_DBNAME?charset=utf8mb4"
# URL-encode SMTP credentials; enable TLS according to the provider's instructions.
MAILER_DSN="smtp://SMTP_USER:URL_ENCODED_PASSWORD@smtp.REPLACE_HOST:587?require_tls=true"
MAIL_FROM="Chess Openings <no-reply@REPLACE_DOMAIN>"
# Opt in only after host delivery checks for local SMTP/Exim or sendmail://default.
ALLOW_LOCAL_MAIL_TRANSPORT=0
