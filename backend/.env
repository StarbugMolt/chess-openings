# Safe defaults. Override on hosting with shared/.env.local (never committed).
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=local-development-only
DEFAULT_URI=http://localhost
MAIL_FROM="Chess Openings <no-reply@example.test>"
PRIVACY_PUBLISHER=StarbugStone
PRIVACY_CONTACT_EMAIL=chessopenings@starbugstone.com
PRIVACY_EMAIL_PROVIDER=O2Switch
PRIVACY_BACKUP_DIRECTORY=
DATABASE_URL="mysql://chess:local-chess-only@127.0.0.1:3306/chess?charset=utf8mb4"

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###
