<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php" colors="true" cacheDirectory="var/phpunit"
         failOnWarning="true" failOnRisky="true" failOnDeprecation="true">
    <php>
        <env name="APP_ENV" value="test" force="true"/>
        <env name="KERNEL_CLASS" value="App\Kernel"/>
    </php>
    <testsuites><testsuite name="Application"><directory>tests</directory></testsuite></testsuites>
    <source><include><directory>src</directory></include></source>
</phpunit>
