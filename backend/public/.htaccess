Options -Indexes -MultiViews
DirectoryIndex index.html
LimitRequestBody 65536
# Token responses finish before synchronous SMTP; compression must preserve their
# exact Content-Length when FastCGI finish_request is unavailable.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/api/auth(?:/|$)" no-gzip=1 no-brotli=1
</IfModule>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
    <Files "index.html">
        Header always set Cache-Control "no-cache"
    </Files>
    <FilesMatch "\.(?:js|css|woff2?|png|svg|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#^/assets/#"
    </FilesMatch>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>
RewriteEngine On
# Let the hosting provider serve individual HTTP-01 tokens for certificate renewal.
RewriteRule ^\.well-known/acme-challenge/[A-Za-z0-9_-]+$ - [END]
RewriteRule (^|/)\. - [F,L]
RewriteRule ^api(?:/|$) index.php [QSA,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^assets/ - [R=404,L]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteRule ^$ index.html [L]
RewriteCond %{REQUEST_URI} !\.[^/]+$
RewriteRule ^ index.html [L]
RewriteRule ^ - [R=404,L]
